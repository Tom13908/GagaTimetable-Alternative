<TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:visibility="gone" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widgetInk3" />
